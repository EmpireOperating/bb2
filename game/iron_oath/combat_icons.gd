extends RefCounted
## Nonidentity action illustrations cropped from user-approved B-combat.png.
## Master SHA256 6baad61c864b9f0c51f2e478ad614f1e69f9bb984f09025cedf95f9cf56cace5
## Original 1672x941; rectangles {"basic": [531, 790, 650, 871], "guard": [700, 792, 819, 872], "recover": [867, 790, 996, 871], "wait": [1038, 790, 1157, 871], "reserves": [1204, 790, 1327, 871]}
## LANCZOS to 108x74, 5px rectangular alpha feather. Embedded PNGs keep
## combat derivatives within owned combat*.gd scope. Special shares the sword
## symbol, not a claim about a fighter's actual equipped weapon. Labels/quotes
## always come from the real action; these icons never supply rules or stats.
const PNG := {
 "basic": "",
 "guard": "",
 "recover": "",
 "wait": "",
 "reserves": ""
}
static var _cache:Dictionary={}
static func texture(action:String) -> Texture2D:
 var key:String="basic" if action=="special" else action
 if not PNG.has(key):return null
 if not _cache.has(key):
  var image:=Image.new()
  if image.load_png_from_buffer(Marshalls.base64_to_raw(PNG[key]))!=OK:return null
  image.generate_mipmaps()
  _cache[key]=ImageTexture.create_from_image(image)
 return _cache[key]
